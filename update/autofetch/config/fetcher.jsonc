{
  // ========== RSSHub 基础地址 ==========
  "baseurl": "https://rsshub.defnothowl.com",
  // ========== 时间范围 ==========
  // "today" | "all" | "YYYYMMDD" | 数字(最近N个自然日，含今天)
  // 默认检查今天和昨天；已处理的 BV 由状态文件去重
  "time_range": 2,
  // 状态文件用于同日多次运行时仅补抓新投稿
  "state_file": "state/fetcher.json",
  // RSS 和 B 站 API 的单次连接/读取超时（秒）、重试次数及退避系数
  "request_timeout": 30,
  "request_retries": 3,
  "retry_backoff_factor": 1.0,
  // ========== 全局默认翻译状态配置 ==========
  // 数字 1~5 固定值，或 "auto" 启用关键字匹配
  "default_translation_status": "auto",
  // 全局默认关键字映射：title 包含关键字 → 对应翻译状态
  // 1:中文内嵌  2:CC字幕  3:弹幕翻译  4:无需翻译  5:暂无翻译
  // 匹配顺序：靠前的优先（命中即停止）
  "default_keyword_map": {
    "中文内嵌": 1,
    "中文字幕": 1,
    "CC字幕": 2,
    "弹幕翻译": 3,
    "无需翻译": 4,
    "生肉": 5
  },
  // 全局默认回退值：所有关键字都不匹配时使用
  // 数字 1~5 或 null（留空）
  "default_fallback": 5,
  // ========== 用户列表 ==========
  // 支持两种写法：
  //   1. 纯字符串 "123456" → 全部使用全局默认配置
  //   2. 对象 { "id": "...", ... } → 按需覆盖
  "users": [
    // // ---- 示例：使用全局默认 ----
    // "123456",
    // // ---- 示例：自定义 auto 关键字映射 + 空回退 ----
    // {
    //   "id": "123456",
    //   "translation_status": "auto",
    //   "keyword_map": {
    //     "中文内嵌": 1,
    //     "中文字幕": 1,
    //     "CC": 2,
    //     "CC字幕": 2,
    //     "弹幕翻译": 3,
    //     "生肉": 5
    //   },
    //   // 没匹配到任何关键字 → CSV 第5列留空
    //   "fallback": null
    // },
    // // ---- 示例：固定翻译状态（不区分标题） ----
    // {
    //   "id": "123456",
    //   "translation_status": 3
    // },
    // // ---- 示例：只抓取 tag 中含指定关键字的视频 ----
    // {
    //   "id": "123456",
    // "tag_keywords": [
    //   "东方PROJECT",
    //   "东方MMD"
    // ]
    // }
    {
      "id": "835843", // 烏馬伊
      "translation_status": 1
    },
    {
      "id": "673546651", // 伊hviewer
      "translation_status": 1,
      "tag_keywords": [
        "东方PROJECT",
        "东方MMD",
        "MMD"
      ]
    }
  ]
}
