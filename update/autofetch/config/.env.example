TENCENT_DOCS_ACCESS_TOKEN=
TENCENT_DOCS_CLIENT_ID=
TENCENT_DOCS_OPEN_ID=

# 163 邮件提醒（与腾讯文档共用此文件）；使用 SMTP 授权码。
AUTOFETCH_MAIL_FROM=your-account@163.com
AUTOFETCH_MAIL_TO=recipient@example.com
AUTOFETCH_MAIL_USER=your-account@163.com
AUTOFETCH_MAIL_PASSWORD=replace-with-smtp-authorization-code

# 可选 HTTP 代理；填写实际地址后取消注释。HTTPS 请求也可使用 http:// 代理。
# http_proxy=http://127.0.0.1:7890
# https_proxy=http://127.0.0.1:7890
# no_proxy=localhost,127.0.0.1
